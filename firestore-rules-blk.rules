rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blkPortal/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blkResources/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blkNotes/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
