rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /blkPortal/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Satu dokumen mewakili satu modul pelatihan.
    // File dan catatan disimpan sebagai daftar di dalam modul tersebut.
    match /blkModules/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Koleksi lama dipertahankan agar data versi sebelumnya tidak terganggu.
    match /blkResources/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blkNotes/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
